---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const selectedCategoryIds = Astro.url.searchParams
    .getAll('category')
    .map((value) => Number(value))
    .filter((id) => Number.isInteger(id) && id > 0);
const selectedPublisherIds = Astro.url.searchParams
    .getAll('publisher')
    .map((value) => Number(value))
    .filter((id) => Number.isInteger(id) && id > 0);
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
const games = await getAllGames(getDatabase());
const hasFilters = selectedCategoryIds.length > 0 || selectedPublisherIds.length > 0;
const gamesPerPage = 6;
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6 shadow-lg">
      <form method="get" class="space-y-6" data-testid="game-filters-form">
        <div>
          <h2 class="text-xl font-semibold text-slate-100 mb-3">Filter games</h2>
        </div>

        <div>
          <h3 class="text-sm font-medium uppercase tracking-wide text-slate-300 mb-3">Categories</h3>
          <div class="flex flex-wrap gap-3">
            {categories.map((category) => {
              const isChecked = selectedCategoryIds.includes(category.id);

              return (
                <label
                  class="flex cursor-pointer items-center gap-2 rounded-full border border-slate-600 bg-slate-900/70 px-3 py-2 text-sm text-slate-200 transition hover:border-blue-400 focus-within:ring-2 focus-within:ring-blue-500"
                  data-testid={`filter-category-${category.id}`}
                >
                  <input
                    type="checkbox"
                    name="category"
                    value={String(category.id)}
                    checked={isChecked}
                    class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-blue-500"
                    aria-label={category.name}
                  />
                  <span>{category.name}</span>
                </label>
              );
            })}
          </div>
        </div>

        <div>
          <h3 class="text-sm font-medium uppercase tracking-wide text-slate-300 mb-3">Publishers</h3>
          <div class="flex flex-wrap gap-3">
            {publishers.map((publisher) => {
              const isChecked = selectedPublisherIds.includes(publisher.id);

              return (
                <label
                  class="flex cursor-pointer items-center gap-2 rounded-full border border-slate-600 bg-slate-900/70 px-3 py-2 text-sm text-slate-200 transition hover:border-purple-400 focus-within:ring-2 focus-within:ring-blue-500"
                  data-testid={`filter-publisher-${publisher.id}`}
                >
                  <input
                    type="checkbox"
                    name="publisher"
                    value={String(publisher.id)}
                    checked={isChecked}
                    class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-purple-500 focus:ring-purple-500"
                    aria-label={publisher.name}
                  />
                  <span>{publisher.name}</span>
                </label>
              );
            })}
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <button
            type="submit"
            class="rounded-full bg-blue-600 px-4 py-2 text-sm font-medium text-white shadow-lg shadow-blue-600/20 transition hover:bg-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="apply-filters-button"
          >
            Apply filters
          </button>

          <a
            href="/"
            class="rounded-full border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition hover:border-slate-500 hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="clear-filters-link"
            hidden={selectedCategoryIds.length === 0 && selectedPublisherIds.length === 0}
          >
            Clear filters
          </a>
        </div>
      </form>
    </div>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      <div hidden={games.length > 0} data-testid="games-empty-state" aria-live="polite">
        <EmptyState text={hasFilters ? 'No games match the selected filters.' : 'No games available at the moment.'} />
      </div>

      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
        data-testid="games-grid"
        hidden={games.length === 0}
      >
        {games.map((game) => <GameCard game={game} />)}
      </div>

      <nav
        class="mt-8 flex items-center justify-center gap-4"
        aria-label="Game list pagination"
        data-testid="pagination"
        hidden={games.length <= gamesPerPage}
      >
        <button
          type="button"
          class="rounded-full border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition hover:border-slate-500 hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none disabled:cursor-not-allowed disabled:opacity-50"
          data-testid="previous-page-button"
          disabled
        >
          Previous
        </button>
        <span class="text-sm text-slate-300" aria-live="polite" data-testid="pagination-status"></span>
        <button
          type="button"
          class="rounded-full border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition hover:border-slate-500 hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none disabled:cursor-not-allowed disabled:opacity-50"
          data-testid="next-page-button"
        >
          Next
        </button>
      </nav>
    </div>
  </div>

  <script is:inline>
    const gamesPerPage = 6;
    const filterForm = document.querySelector('[data-testid="game-filters-form"]');
    const gameCards = Array.from(document.querySelectorAll('[data-testid="game-card"]'));
    const emptyState = document.querySelector('[data-testid="games-empty-state"]');
    const gamesGrid = document.querySelector('[data-testid="games-grid"]');
    const clearFiltersLink = document.querySelector('[data-testid="clear-filters-link"]');
    const pagination = document.querySelector('[data-testid="pagination"]');
    const previousPageButton = document.querySelector('[data-testid="previous-page-button"]');
    const nextPageButton = document.querySelector('[data-testid="next-page-button"]');
    const paginationStatus = document.querySelector('[data-testid="pagination-status"]');
    const filterInputs = Array.from(document.querySelectorAll('input[name="category"], input[name="publisher"]'));
    const initialPage = Number(new URLSearchParams(window.location.search).get('page') || 1);
    let currentPage = Number.isInteger(initialPage) && initialPage > 0 ? initialPage : 1;

    const syncQueryString = () => {
      const params = new URLSearchParams(window.location.search);
      params.delete('category');
      params.delete('publisher');
      params.delete('page');
      if (currentPage > 1) {
        params.set('page', String(currentPage));
      }

      filterInputs.forEach((input) => {
        if (input.checked) {
          params.append(input.name, input.value);
        }
      });

      const queryString = params.toString();
      const nextUrl = queryString ? `${window.location.pathname}?${queryString}` : window.location.pathname;
      window.history.replaceState({}, '', nextUrl);
    };

    const applyFilters = (resetPage = false) => {
      if (resetPage) {
        currentPage = 1;
      }

      const selectedCategories = new Set(
        Array.from(document.querySelectorAll('input[name="category"]:checked')).map((input) => Number(input.value)),
      );
      const selectedPublishers = new Set(
        Array.from(document.querySelectorAll('input[name="publisher"]:checked')).map((input) => Number(input.value)),
      );

      let visibleCount = 0;

      gameCards.forEach((card) => {
        const categoryId = Number(card.dataset.categoryId || 0);
        const publisherId = Number(card.dataset.publisherId || 0);
        const categoryMatches = selectedCategories.size === 0 || selectedCategories.has(categoryId);
        const publisherMatches = selectedPublishers.size === 0 || selectedPublishers.has(publisherId);
        if (categoryMatches && publisherMatches) {
          visibleCount += 1;
        }
      });

      const totalPages = Math.max(1, Math.ceil(visibleCount / gamesPerPage));
      currentPage = Math.min(currentPage, totalPages);
      let matchingIndex = 0;
      gameCards.forEach((card) => {
        const categoryId = Number(card.dataset.categoryId || 0);
        const publisherId = Number(card.dataset.publisherId || 0);
        const categoryMatches = selectedCategories.size === 0 || selectedCategories.has(categoryId);
        const publisherMatches = selectedPublishers.size === 0 || selectedPublishers.has(publisherId);
        const isMatching = categoryMatches && publisherMatches;
        const pageStart = (currentPage - 1) * gamesPerPage;
        const isOnCurrentPage = isMatching && matchingIndex >= pageStart && matchingIndex < pageStart + gamesPerPage;

        card.hidden = !isOnCurrentPage;
        if (isMatching) {
          matchingIndex += 1;
        }
      });

      if (emptyState) {
        emptyState.hidden = visibleCount > 0;
      }

      if (gamesGrid) {
        gamesGrid.hidden = visibleCount === 0;
      }

      if (clearFiltersLink) {
        clearFiltersLink.hidden = selectedCategories.size === 0 && selectedPublishers.size === 0;
      }

      if (pagination) {
        pagination.hidden = visibleCount <= gamesPerPage;
      }

      if (previousPageButton) {
        previousPageButton.disabled = currentPage === 1;
      }

      if (nextPageButton) {
        nextPageButton.disabled = currentPage >= totalPages;
      }

      if (paginationStatus) {
        paginationStatus.textContent = `Page ${currentPage} of ${totalPages}`;
      }

      syncQueryString();
    };

    if (filterForm) {
      filterForm.addEventListener('submit', (event) => {
        event.preventDefault();
        applyFilters(true);
      });
    }

    filterInputs.forEach((input) => {
      input.addEventListener('change', () => {
        applyFilters(true);
      });
    });

    previousPageButton?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage -= 1;
        applyFilters();
      }
    });

    nextPageButton?.addEventListener('click', () => {
      currentPage += 1;
      applyFilters();
    });

    applyFilters();
  </script>
</Layout>
